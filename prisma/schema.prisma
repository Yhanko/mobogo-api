
generator client {
  provider      = "prisma-client-js"
  output        = "./generated/prisma"
  binaryTargets = ["native", "linux-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  DRIVER
  PASSENGER
  CLIENT
  LOTADOR
}

enum TicketStatus {
  PENDING
  USED
  TRANSFERRED
  CANCELLED
  EXPIRED
}

enum TransactionType {
  TOPUP
  PAYMENT
  WITHDRAWAL
  REFUND
  TRANSFER_IN
  TRANSFER_OUT
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_TRIP
  BLOCKED
}

// ─────────────────────────────────────────────
// USER — entidade central, todos os actores
// ─────────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  phone       String?   @unique
  displayId   String?   @unique @map("display_id")
  name        String
  pinHash     String?   @map("pin_hash")         // passageiros sem telefone usam PIN
  passwordHash String?  @map("password_hash")    // admin, agent, client, driver
  role        Role
  isActive    Boolean   @default(true) @map("is_active")
  isBlocked   Boolean   @default(false) @map("is_blocked")
  blockReason String?   @map("block_reason")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")        // soft delete

  // relações
  createdBy            User?            @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers         User[]           @relation("CreatedBy")
  agentProfile         Agent?
  adminAgents          Agent[]          @relation("AdminAgents")
  driverProfile        Driver?
  clientDrivers        Driver[]         @relation("ClientDrivers")
  wallet               Wallet?
  ticketsAsPassenger   Ticket[]         @relation("PassengerTickets")
  ticketsEmitted       Ticket[]         @relation("EmittedTickets")
  ticketsTransferredTo Ticket[]         @relation("TransferredTickets")
  lotadorPartnerships  LotadorPartner[] @relation("LotadorUser")
  auditLogs            AuditLog[]

  @@index([phone])
  @@index([displayId])
  @@index([role])
  @@map("users")

  // Nota: validação de identidade (phone ou displayId) é feita na camada de aplicação
}

// ─────────────────────────────────────────────
// AGENT — criado por admin, tem permissões delegadas
// ─────────────────────────────────────────────

model Agent {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  adminId           String    @map("admin_id")
  isActive          Boolean   @default(true) @map("is_active")
  dailyTicketLimit  Int       @default(100) @map("daily_ticket_limit")
  permissions       String[]  @default([])   // ex: ["ticket:create","passenger:register"]
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id])
  admin             User      @relation("AdminAgents", fields: [adminId], references: [id])

  // relações inversas para admin
  // NOTE: adicionar em User se precisar de listar agentes do admin
  @@index([adminId])
  @@map("agents")
}

// workaround: segunda relação User->Agent para admin
// (Prisma exige nome explícito em relações ambíguas)
// Adiciona em User: adminAgents Agent[] @relation("AdminAgents")

// ─────────────────────────────────────────────
// DRIVER — taxista, vinculado a um CLIENT
// ─────────────────────────────────────────────

model Driver {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  clientId       String       @map("client_id")          // quem contratou o taxista
  licensePlate   String       @unique @map("license_plate")
  status         DriverStatus @default(ACTIVE)
  workDays       Int[]        @default([1,2,3,4,5])      // 0=Dom ... 6=Sáb
  currentBalance Decimal      @default(0) @map("current_balance") @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user               User             @relation(fields: [userId], references: [id])
  client             User             @relation("ClientDrivers", fields: [clientId], references: [id])
  ticketsReceived    Ticket[]         @relation("DriverTickets")
  locationEvents     LocationEvent[]
  lotadorPartnerships LotadorPartner[] @relation("DriverPartner")

  @@index([clientId])
  @@index([status])
  @@map("drivers")
}

// ─────────────────────────────────────────────
// WALLET — carteira digital
// ─────────────────────────────────────────────

model Wallet {
  id         String        @id @default(uuid())
  userId     String        @unique @map("user_id")
  balance    Decimal       @default(0) @db.Decimal(12, 2)
  currency   String        @default("AOA")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("wallets")
}

// ─────────────────────────────────────────────
// TICKET — passagem, coração do sistema
// ─────────────────────────────────────────────

model Ticket {
  id              String       @id @default(uuid())
  passengerId     String       @map("passenger_id")
  driverId        String       @map("driver_id")
  issuedById      String       @map("issued_by_id")
  amount          Decimal      @db.Decimal(10, 2)
  status          TicketStatus @default(PENDING)

  // identificação
  qrNonce         String       @unique @map("qr_nonce")  // nonce interno, não exposto
  shortCode       String?      @unique @map("short_code") // 6 dígitos para sem QR

  // transferência
  transferredToId String?      @map("transferred_to_id")
  transferredAt   DateTime?    @map("transferred_at")

  // cancelamento
  cancelReason    String?      @map("cancel_reason")
  cancelledById   String?      @map("cancelled_by_id")

  // timestamps
  usedAt          DateTime?    @map("used_at")
  expiresAt       DateTime     @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  passenger       User         @relation("PassengerTickets", fields: [passengerId], references: [id])
  driver          Driver       @relation("DriverTickets", fields: [driverId], references: [id])
  issuedBy        User         @relation("EmittedTickets", fields: [issuedById], references: [id])
  transferredTo   User?        @relation("TransferredTickets", fields: [transferredToId], references: [id])
  transactions    Transaction[]

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([shortCode])
  @@map("tickets")
}

// ─────────────────────────────────────────────
// TRANSACTION — registo financeiro imutável
// ─────────────────────────────────────────────

model Transaction {
  id          String          @id @default(uuid())
  walletId    String          @map("wallet_id")
  ticketId    String?         @map("ticket_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  balanceBefore Decimal       @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal       @map("balance_after")  @db.Decimal(12, 2)
  reference   String?                                // referência externa (MB, etc.)
  metadata    Json?                                  // dados extra sem schema fixo
  createdAt   DateTime        @default(now()) @map("created_at")

  wallet      Wallet          @relation(fields: [walletId], references: [id])
  ticket      Ticket?         @relation(fields: [ticketId], references: [id])

  @@index([walletId])
  @@index([ticketId])
  @@index([createdAt])
  @@map("transactions")
}

// ─────────────────────────────────────────────
// LOCATION_EVENT — série temporal GPS
// (idealmente na TimescaleDB como hypertable)
// ─────────────────────────────────────────────

model LocationEvent {
  id          String   @id @default(uuid())
  driverId    String   @map("driver_id")
  lat         Float
  lng         Float
  speed       Float    @default(0)
  heading     Float?                        // direcção em graus
  recordedAt  DateTime @map("recorded_at")

  driver      Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, recordedAt(sort: Desc)])
  @@map("location_events")
}

// ─────────────────────────────────────────────
// LOTADOR_PARTNER — parceria taxista-lotador
// ─────────────────────────────────────────────

model LotadorPartner {
  id            String   @id @default(uuid())
  driverId      String   @map("driver_id")
  lotadorUserId String   @map("lotador_user_id")
  referenceCode String   @unique @map("reference_code")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  driver        Driver   @relation("DriverPartner", fields: [driverId], references: [id])
  lotador       User     @relation("LotadorUser", fields: [lotadorUserId], references: [id])

  @@unique([driverId, lotadorUserId])
  @@map("lotador_partners")
}

// ─────────────────────────────────────────────
// AUDIT_LOG — registo imutável de todas as acções
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String                        // ex: "ticket:cancel", "user:block"
  entityType String   @map("entity_type")  // ex: "Ticket", "User"
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
