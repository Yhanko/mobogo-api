# ── Aplicação ─────────────────────────────────────────────────────────────────
ENVOIREMENT=development
PORT=
APP_NAME=
APP_VERSION=

# ── Base de dados (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=

# Pool de conexões
DB_POOL_MIN=
DB_POOL_MAX=
DB_POOL_ACQUIRE_TIMEOUT=
DB_POOL_IDLE_TIMEOUT=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# TTLs (segundos) — ajusta conforme necessidade
REDIS_TTL_SESSION=
REDIS_TTL_REFRESH=
REDIS_TTL_QR=
REDIS_TTL_USED_TICKET=
REDIS_TTL_PERM_CACHE=
REDIS_TTL_SHORT_CODE=
REDIS_TTL_GPS=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 64 caracteres — gera com: openssl rand -hex 64
JWT_SECRET=
JWT_ACCESS_EXPIRES=
JWT_REFRESH_EXPIRES=
JWT_ROTATION_ENABLED=
JWT_ISSUER=
JWT_AUDIENCE=

# ── QR Code ───────────────────────────────────────────────────────────────────
# Mínimo 64 caracteres — gera com: openssl rand -hex 64
QR_HMAC_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separa múltiplas origens por vírgula
CORS_ORIGINS=
# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# ── Tickets ───────────────────────────────────────────────────────────────────
TICKET_DEFAULT_VALUE=
TICKET_DEFAULT_DAILY_MAX=
TICKET_EXPIRES_IN_HOURS=

# ── Paginação ─────────────────────────────────────────────────────────────────
PAGINATION_DEFAULT_LIMIT=
PAGINATION_MAX_LIMIT=

# ── Swagger ───────────────────────────────────────────────────────────────────
# Desactivado automaticamente em NODE_ENV=production
SWAGGER_ENABLED=
SWAGGER_PATH=
